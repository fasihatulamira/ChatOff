# Copy this file to .env in the same folder as app.py (or ChatOff.exe).
# Settings are loaded from the application directory, not the terminal working directory.

# ── MySQL (required) ──────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=chatdb

# First-time DB setup (PowerShell):
#   mysql -u root -p -e "CREATE DATABASE IF NOT EXISTS chatdb;"
#   Get-Content schema.sql -Raw | mysql -u root -p chatdb

# ── Ollama (required) ─────────────────────────────────────────────
# Chat model — llama3.2:3b is faster on 8GB RAM; use llama3 for higher quality
OLLAMA_MODEL=llama3.2:3b

# Embedding model for RAG (do NOT use a chat model here)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Max tokens to generate per reply
OLLAMA_NUM_PREDICT=1280

# Token budget when answering from PDF documents
OLLAMA_RAG_NUM_PREDICT=2048

# Extra budget for overview / "ada apa dalam pdf" / senaraikan semua questions
OLLAMA_LIST_NUM_PREDICT=3072

# Context window for non-RAG chat. Leave OLLAMA_RAG_NUM_CTX empty for model default (most stable).
OLLAMA_NUM_CTX=4096
OLLAMA_RAG_NUM_CTX=

# Keep models loaded in RAM between prompts (also: setx OLLAMA_KEEP_ALIVE "30m" then restart Ollama)
OLLAMA_KEEP_ALIVE=30m

# CPU threads for Ollama (leave empty for auto)
OLLAMA_NUM_THREAD=

# Max tokens for sidebar title generation (keep low)
OLLAMA_TITLE_NUM_PREDICT=32

# Sampling temperature (lower = more stable RAG answers; 0.2–0.5 recommended)
OLLAMA_TEMPERATURE=0.3

# Penalize repeated phrases (1.15–1.25 reduces duplicate lines)
OLLAMA_REPEAT_PENALTY=1.2
OLLAMA_RAG_REPEAT_PENALTY=1.0
OLLAMA_REPEAT_LAST_N=64

# Retry once on transient Ollama connection errors
OLLAMA_MAX_RETRIES=1

# Keep model loaded in Ollama RAM (set in Windows env vars, then restart Ollama):
#   setx OLLAMA_KEEP_ALIVE "30m"

# Pull models before first run:
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text

# ── RAG tuning ────────────────────────────────────────────────────
# How many PDF chunks to inject (higher = more complete list answers)
RAG_TOP_K=5

# Max characters of document context sent to the model
RAG_MAX_CONTEXT_CHARS=4000

# Extra chunks for "list all" / "senaraikan semua" style questions
RAG_LIST_TOP_K=7

# Include neighboring chunks from the same PDF (helps numbered lists span chunks)
RAG_NEIGHBOR_RADIUS=1

# Minimum similarity per chunk (0.0–1.0). Higher = stricter matches
RAG_MIN_SCORE=0.35

# Best-match gate: if top chunk score is below this, skip RAG and use general AI
RAG_BEST_MIN_SCORE=0.45

# Chunking (heading-aware sections)
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=250

# OCR for scanned PDFs (optional — pip install -r requirements-ocr.txt + Tesseract)
RAG_OCR_ENABLED=false

# ── Topic Builder ─────────────────────────────────────────────────
TOPIC_BUILDER_MAX_CHARS=12000

# Delay before sidebar title generation (ms) — avoids competing with main reply
TITLE_GEN_DELAY_MS=8000

# Stream UI refresh interval (ms) — higher = smoother, slightly less live
STREAM_FLUSH_MS=120
